# Copy to .env, then enter your key locally. Never use VITE_ for API secrets.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# auto uses Gemini when configured; scripted always uses the offline story.
DIALOGUE_MODE=auto

# Optional automatic backup when Gemini fails. Keep both keys server-side.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# openai skips Gemini; gemini enables Gemini-first with OpenAI backup.
AI_PROVIDER=openai

ELEVENLABS_API_KEY=
ELEVENLABS_ALEX_VOICE_ID=voice_id_here
ELEVENLABS_JORDAN_VOICE_ID=voice_id_here
ELEVENLABS_SAM_VOICE_ID=voice_id_here
ELEVENLABS_LUCIA_VOICE_ID=voice_id_here
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
