# Copy to .env, then enter your key locally. Never use VITE_ for API secrets.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# auto uses Gemini when configured; scripted always uses the offline story.
DIALOGUE_MODE=auto

# Optional automatic backup when Gemini fails. Keep both keys server-side.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# openai skips Gemini; gemini enables Gemini-first with OpenAI backup.
AI_PROVIDER=openai
